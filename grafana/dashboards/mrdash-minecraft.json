{
  "uid": "mrdash-minecraft",
  "title": "MRDash Minecraft 서버 (PrometheusExporter)",
  "description": "MRDash /monitoring/:serverId 페이지에 패널 단위로 들어가는 대시보드. 서버 설정의 Job Name·Targets가 var-job·var-instance로 넘어온다. 지표 이름은 backend/src/util/exporterMetrics.js와 같다.",
  "tags": [
    "mrdash"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "refresh": "15s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "job-query"
        },
        "definition": "label_values(up, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "Targets",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "instance-query"
        },
        "definition": "label_values(up{job=\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": true,
        "multi": false,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "접속자 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mc_players_online_total{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "접속자"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "TPS",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 19,
            "axisSoftMax": 20.1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#c98500"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 20
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(mc_tps{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "TPS"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "엔티티 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#d55181"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mc_entities_total{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "엔티티"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "로드된 청크 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#9085e9"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mc_loaded_chunks_total{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "청크"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "힙 메모리",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "JVM 힙 — 사용 = 할당(allocated) − 여유(free), 최대 = -Xmx (mc_jvm_memory)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#199e70"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "할당"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#898781"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "최대"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e34948"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mc_jvm_memory{job=\"$job\", instance=~\"$instance\", type=\"allocated\"}) - sum(mc_jvm_memory{job=\"$job\", instance=~\"$instance\", type=\"free\"})",
          "legendFormat": "사용"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(mc_jvm_memory{job=\"$job\", instance=~\"$instance\", type=\"allocated\"})",
          "legendFormat": "할당"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mc_jvm_memory{job=\"$job\", instance=~\"$instance\", type=\"max\"})",
          "legendFormat": "최대"
        }
      ]
    }
  ]
}
