# docker-compose의 backend 서비스에 env_file로 그대로 주입된다.
# 실제 값을 채운 .env로 복사해서 쓸 것 (.env는 git에 안 올라감).

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://dash.ddeltas.kro.kr

# 기존 192.168.55.80 MySQL/Redis 인스턴스를 그대로 쓰되, dev(mrd)와 분리된
# 운영용 DB/논리 DB를 새로 만들어서 가리킨다.
DATABASE_URL=mysql://root:PASSWORD@192.168.55.80:3306/mrd_prod
SESSION_REDIS_URL=redis://192.168.55.80:6379/1
SESSION_REDIS_PASSWORD=

SESSION_SECRET=changeme
SESSION_COOKIE_MAX_AGE=604800000

# 운영에서는 로컬 로그인 우회를 꺼둔다.
ALLOW_LOCAL_AUTH=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_CALLBACK=https://dash.ddeltas.kro.kr/api/auth/discord/redirect
