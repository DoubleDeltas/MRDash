# docker-compose의 backend, discord-bot 서비스에 env_file로 그대로 주입된다.
# 실제 값을 채운 .env로 복사해서 쓸 것 (.env는 git에 안 올라감).

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://dash.ddeltas.kro.kr

# 기존 192.168.55.80 MySQL/Redis 인스턴스를 그대로 쓰되, dev(mrd)와 분리된
# 운영용 DB/논리 DB를 새로 만들어서 가리킨다.
DATABASE_URL=mysql://root:PASSWORD@192.168.55.80:3306/mrd_prod
SESSION_REDIS_URL=redis://192.168.55.80:6379/1
SESSION_REDIS_PASSWORD=

SESSION_SECRET=changeme
SESSION_COOKIE_MAX_AGE=604800000

# 운영에서는 로컬 로그인 우회를 꺼둔다.
ALLOW_LOCAL_AUTH=false

# 호스트 Prometheus (node-exporter, cadvisor 등을 scrape 중인 인스턴스).
# 백엔드 컨테이너에서 접근 가능한 주소여야 한다.
PROMETHEUS_URL=http://prometheus:9090

# 모니터링 그래프·경보 엔진 Grafana (docker-compose의 grafana 서비스, MRDash 전용).
# 백엔드가 /api/grafana/* 를 여기로 넘긴다. mrd-grafana-net의 별칭 mrdash-grafana로만 접속해야
# 출발 IP가 auth.proxy whitelist와 맞는다 (grafana/README.md). 기본값 http://mrdash-grafana:3000
GRAFANA_URL=http://mrdash-grafana:3000
# 외부 Prometheus를 쓰는 서버의 Grafana 데이터 소스를 자동 관리할 서비스 계정 토큰 (Admin 역할).
# 비워 두면 외부 Prometheus 서버의 그래프는 그려지지 않는다. 발급 방법은 grafana/README.md
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Grafana 경보 → "테트라" 봇 채널 알림용 webhook 시크릿 (Grafana가 Authorization: Bearer로 붙여 보낸다).
# 비워 두면 봇 채널 알림은 꺼진다 (웹후크 알림은 그대로 동작). 다른 시크릿과 다른 임의의 긴 문자열로.
GRAFANA_ALERT_WEBHOOK_SECRET=
# 선택: 경보 타이밍 (Grafana 기간 형식 30s/1m/4h/1d). 바꾸면 backend 재시작 시(또는 10분 안에) Grafana에 반영된다.
# 규칙 평가 주기 (기본 30s, 10초 단위로 맞춘다)
# GRAFANA_ALERT_EVALUATION_INTERVAL=30s
# 조건이 이만큼 계속돼야 경보 (기본 1m)
# GRAFANA_ALERT_PENDING_PERIOD=1m
# 경보가 계속될 때 같은 알림을 다시 보내는 간격 (기본 4h)
# GRAFANA_ALERT_REPEAT_INTERVAL=4h
# 선택: MRDash Prometheus 서버의 경보 규칙이 쓰는 Grafana 데이터 소스 uid (기본 mrdash-host)
# GRAFANA_DEFAULT_DATASOURCE_UID=mrdash-host
# 선택: Grafana가 부를 backend 주소 (기본 http://mrdash-backend:3000/internal/grafana/alerts)
# GRAFANA_ALERT_WEBHOOK_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_CALLBACK=https://dash.ddeltas.kro.kr/api/auth/discord/redirect

# backend /internal API 시크릿. 둘 다 미설정 시 내부 API 비활성.
# 전체 권한 (backend와 discord-bot이 공유)
INTERNAL_API_SECRET=
# 조회(GET) 전용 (마랜디위키 등 다른 내부 서비스에 발급). INTERNAL_API_SECRET과 다른 값으로.
READONLY_API_SECRET=

# ---- discord-bot ----
# Developer Portal > Bot > Token ("Server Members Intent" 활성화 필요)
DISCORD_BOT_TOKEN=
# "마랜디" 디스코드 서버(길드) ID
MRD_GUILD_ID=
# 전체 멤버 동기화 주기(분)
MEMBER_SYNC_INTERVAL_MINUTES=60
